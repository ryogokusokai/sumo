 "method": [
  "番付は千秋楽の翌々日の番付編成会議で決まり、次の場所の約2週間前に発表されます。",
  "計算の目安は「1点の勝ち越しで1枚上がる」。九州場所の地位に勝ち越し点（休んだ日は負けとして数える）を足して順位をつけました。",
  "そのあと慣例にあわせて手で直しました。十両から上がる力士は計算より低め、三役から落ちる力士は落ち幅を小さく、関脇で1点負け越しは小結に、としています。",
  "幅を示したのは、判断が分かれて上下しやすい力士です。"
 ],
 "points": [
  {
   "h": "藤凌駕を3人目の小結にするか",
   "t": "小結の空きは、美ノ海と義ノ富士が負け越して2つ。関脇から落ちる藤ノ川と13勝の若元春で埋まると見て、前頭筆頭で9勝の藤凌駕は東前頭筆頭にしました。三役に定員はないので、小結を3人にする可能性もあり、ほぼ五分五分です。"
  },
  {
   "h": "大関の順番",
   "t": "10勝の霧島を筆頭に、勝ち越した琴櫻を西、負け越してかど番の安青錦を3番目にしました。スポーツ報知は安青錦を西の大関にしています。"
  },
  {
   "h": "5人目の入れ替え",
   "t": "前頭14枚目で5勝10敗の時疾風を残すか、十両12枚目で13勝の旭富士を上げるか。十両の下の方で大勝ちした力士は控えめに扱われやすいので、旭富士は十両筆頭にしました。"
  },
  {
   "h": "熱海富士は関脇のまま",
   "t": "三役での直近3場所は12勝・8勝・11勝の計31勝で、大関昇進の目安とされる33勝に届かないため、昇進はないと見ました。"
  },
  {
   "h": "十両と幕下の入れ替えは4人",
   "t": "十両から幕下へは白熊（全休）、羽出山、明生、竜鳳。幕下からは碇潟、夢道鵬、豪刃雄、不動豊。十両11枚目で5勝10敗の佐田の海、十両4枚目で2勝13敗の一意も計算上は落ちる位置ですが、上がる候補の数から残ると見ました。"
  }
 ],
